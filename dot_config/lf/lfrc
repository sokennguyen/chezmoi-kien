set shell sh
set shellopts '-eu'
set ifs "\n"

set preview true
set dirpreviews true
set drawbox true
set cursorpreviewfmt "\033[7;2m"
set scrolloff 10
set previewer ~/.config/lf/preview.sh

map <enter> open
map gh cd ~

cmd open &{{
    case $(file --mime-type -Lb -- "$f") in
        image/*) for f in $fx; do feh "$f" > /dev/null 2>&1 & done;;
        *) for f in $fx; do xdg-open "$f" > /dev/null 2>&1 & done;;
    esac
}}
