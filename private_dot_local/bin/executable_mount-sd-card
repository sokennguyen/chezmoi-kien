#!/usr/bin/env bash
set -euo pipefail

dry_run=0
if [[ "${1:-}" == "--dry-run" ]]; then
  dry_run=1
fi

pick_json() {
python3 - <<'PY'
import json, subprocess
raw = subprocess.check_output([
    'lsblk', '-J', '-o', 'NAME,PATH,TYPE,PKNAME,RM,TRAN,FSTYPE,LABEL,MOUNTPOINT,MODEL'
], text=True)
data = json.loads(raw)

nodes = {}

def walk(items):
    for item in items:
        nodes[item.get('name')] = item
        for ch in item.get('children', []) or []:
            walk([ch])
walk(data.get('blockdevices', []))

candidates = []
for item in nodes.values():
    if item.get('type') != 'part':
        continue
    if not item.get('fstype'):
        continue
    parent = nodes.get(item.get('pkname')) if item.get('pkname') else None
    rm = (parent or item).get('rm')
    tran = (parent or item).get('tran')
    if not rm:
        continue
    if tran not in ('usb', 'mmc'):
        continue
    candidates.append({
        'path': item.get('path'),
        'label': item.get('label') or '',
        'mountpoint': item.get('mountpoint') or '',
        'model': (parent or item).get('model') or '',
        'tran': tran or '',
    })

if not candidates:
    print(json.dumps({'status':'none'}))
    raise SystemExit(0)

candidates.sort(key=lambda x: (0 if x['mountpoint'] else 1, 0 if x['label'] else 1, x['path']))
if len(candidates) > 1:
    mounted = [c for c in candidates if c['mountpoint']]
    if len(mounted) == 1:
        print(json.dumps({'status':'ok','candidate':mounted[0]}))
        raise SystemExit(0)
    print(json.dumps({'status':'multiple','candidates':candidates}))
    raise SystemExit(0)

print(json.dumps({'status':'ok','candidate':candidates[0]}))
PY
}

json="$(pick_json)"
status="$(python3 - <<'PY' "$json"
import json, sys
print(json.loads(sys.argv[1])['status'])
PY
)"

if [[ "$status" == "none" ]]; then
  echo "No removable SD/USB card partition found."
  exit 1
fi

if [[ "$status" == "multiple" ]]; then
  echo "Multiple removable card partitions found:"
  python3 - <<'PY' "$json"
import json, sys
for c in json.loads(sys.argv[1])['candidates']:
    print(f"- {c['path']}  label={c['label'] or '-'}  mounted={c['mountpoint'] or '-'}  model={c['model'] or '-'}")
PY
  exit 1
fi

part="$(python3 - <<'PY' "$json"
import json, sys
print(json.loads(sys.argv[1])['candidate']['path'])
PY
)"
label="$(python3 - <<'PY' "$json"
import json, sys
print(json.loads(sys.argv[1])['candidate']['label'])
PY
)"
mounted="$(python3 - <<'PY' "$json"
import json, sys
print(json.loads(sys.argv[1])['candidate']['mountpoint'])
PY
)"
model="$(python3 - <<'PY' "$json"
import json, sys
print(json.loads(sys.argv[1])['candidate']['model'])
PY
)"

if [[ -n "$mounted" ]]; then
  echo "Already mounted: $part -> $mounted"
  exit 0
fi

safe_label="$(printf '%s' "${label:-sdcard}" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
[[ -n "$safe_label" ]] || safe_label="sdcard"
mountpoint="/mnt/$safe_label"

if [[ "$dry_run" -eq 1 ]]; then
  echo "Would mount: $part"
  echo "Model: ${model:-unknown}"
  echo "Label: ${label:-none}"
  echo "Mountpoint: $mountpoint"
  exit 0
fi

echo "Mounting $part at $mountpoint"
sudo mkdir -p "$mountpoint"
sudo mount "$part" "$mountpoint"
echo "Mounted: $part -> $mountpoint"
